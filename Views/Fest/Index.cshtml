@model List<Participant>

@{
    ViewData["Title"] = "Participants";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h2>
            Registered Participants
        </h2>

        <div>

            <a asp-action="Register"
               class="btn btn-primary">

                Register Participant

            </a>

            <a asp-action="Welcome"
               class="btn btn-info">

                Welcome

            </a>

        </div>

    </div>


    @if (Model.Count == 0)
    {
        <div class="alert alert-warning">

            No participants have registered yet.

        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-bordered table-striped">

                <thead class="table-dark">

                    <tr>

                        <th>ID</th>

                        <th>Name</th>

                        <th>Email</th>

                        <th>Department</th>

                        <th>Year</th>

                        <th>Event</th>

                        <th>Status</th>

                        <th>Fee</th>

                        <th>Action</th>

                    </tr>

                </thead>


                <tbody>

                    @foreach (var participant in Model)
                    {
                        <tr>

                            <td>
                                @participant.ParticipantId
                            </td>

                            <td>
                                @participant.ParticipantName
                            </td>

                            <td>
                                @participant.Email
                            </td>

                            <td>
                                @participant.Department
                            </td>

                            <td>
                                @participant.Year
                            </td>

                            <td>
                                @participant.EventName
                            </td>


                            <!-- Registration Status -->
                            <td>

                                @if (participant.GetRegistrationStatus() == "Confirmed")
                                {
                                    <span class="badge bg-success">
                                        Confirmed
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">
                                        Pending
                                    </span>
                                }

                            </td>


                            <!-- Fee -->
                            <td>

                                ₹@(participant.RegistrationFee ?? 0)

                                <br />

                                <small>
                                    @participant.GetFeeCategory()
                                </small>

                            </td>


                            <!-- Details Button -->
                            <td>

                                <a asp-action="Details"
                                   asp-route-id="@participant.ParticipantId"
                                   class="btn btn-sm btn-info">

                                    Details

                                </a>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

</div>