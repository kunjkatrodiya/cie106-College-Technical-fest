@{
    ViewData["Title"] = "Welcome";
}

<div class="container mt-5">

    <div class="card shadow text-center p-5">

        <h1 class="display-5">

            Welcome to AMTICS Technical Fest

        </h1>


        <p class="lead mt-3">

            Explore, compete, innovate and showcase
            your technical skills!

        </p>


        <p>

            Register yourself for exciting technical
            events and become a part of the
            College Technical Fest.

        </p>


        <div class="mt-4">

            <a asp-action="Index"
               class="btn btn-primary me-2">

                View Participants

            </a>


            <a asp-action="Register"
               class="btn btn-success">

                Register Now

            </a>

        </div>

    </div>

</div>